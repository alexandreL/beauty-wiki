{
  "name": "beauty-wiki",
  "version": "0.1.3",
  "private": true,
  "description": "Redesign de lecture pour Wikip\u00e9dia, sans compte ni IA.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandreL/beauty-wiki.git"
  },
  "homepage": "https://github.com/alexandreL/beauty-wiki#readme",
  "bugs": {
    "url": "https://github.com/alexandreL/beauty-wiki/issues"
  },
  "scripts": {
    "test": "node --test --test-force-exit tests/unit/*.test.js tests/e2e/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "lint": "web-ext lint --source-dir . --ignore-files \"tests/**\" \"docs/**\" \"node_modules/**\" \".superpowers/**\" \"dist/**\" \"artifacts/**\" \"scripts/**\" \".github/**\"",
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:chrome": "node scripts/build.mjs chrome"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "web-ext": "^8.9.0"
  }
}
